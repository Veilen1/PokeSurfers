{
  "name": "@trailkin/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "predev": "npm --prefix ../shared run build",
    "build": "tsc -p tsconfig.json",
    "prebuild": "npm --prefix ../shared run build",
    "start": "node dist/server.js",
    "migrate": "node-pg-migrate up --migrations-dir migrations",
    "migrate:rollback": "node-pg-migrate down --migrations-dir migrations",
    "test": "vitest run",
    "pretest": "npm --prefix ../shared run build"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@trailkin/shared": "*",
    "fastify": "^5.6.0",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "node-pg-migrate": "^9.0.0",
    "vitest": "^3.2.4"
  }
}
