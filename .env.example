NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://trailkin:trailkin@localhost:5433/trailkin
POSTGRES_USER=trailkin
POSTGRES_PASSWORD=trailkin
POSTGRES_DB=trailkin
# Set a unique random value of at least 32 bytes outside local development.
SESSION_SECRET=replace-with-a-random-secret-at-least-32-bytes

# ---------------------------------------------------------------------------
# Frontend / Vercel
# ---------------------------------------------------------------------------

# Server-side proxy (api/proxy.ts). Backend base URL WITHOUT the /api suffix.
# In Vercel, set this in the frontend project (e.g. https://pokesurfers-api.onrender.com).
# If it is missing, the app still works in guest mode.
BACKEND_URL=http://localhost:3000

# Local development only. Leave it unset in production so the client uses /api
# same-origin through the Vercel proxy (avoids CORS and third-party cookies).
# VITE_API_BASE_URL=http://localhost:3000/api

# Optional external donation page. Use HTTPS; donations must not grant in-game benefits.
VITE_DONATION_URL=

# Backend CORS origin (only used when the backend is called directly).
WEB_ORIGIN=http://localhost:5173
